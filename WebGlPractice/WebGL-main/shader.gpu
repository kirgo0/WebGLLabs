// Vertex shader
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
attribute vec2 texCoord;
attribute vec3 tangent;

uniform mat4 ModelViewMatrix;
uniform mat4 ProjectionMatrix;

varying vec3 vPosition;   // position in eye space
varying vec2 vTexCoord;
varying vec3 vT;
varying vec3 vB;
varying vec3 vN;

void main() {
    // Position in eye space
    vec4 posEye = ModelViewMatrix * vec4(vertex, 1.0);
    vPosition = posEye.xyz;
    vTexCoord = texCoord;

    // Transform normal and tangent to eye space
    mat3 MV3 = mat3(ModelViewMatrix);
    vec3 T = MV3 * tangent;
    vec3 N = MV3 * normal;

    // ===== Gram–Schmidt with TANGENT priority =====
    // 1. Normalize tangent – головний вектор базису
    T = normalize(T);

    // 2. Робимо нормаль ортогональною до тангента
    N = normalize(N - T * dot(N, T));

    // 3. Бінормаль як векторний добуток
    vec3 B = cross(N, T);

    vT = T;
    vB = B;
    vN = N;

    gl_Position = ProjectionMatrix * posEye;
}`;


// Fragment shader
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif

varying vec3 vPosition;
varying vec2 vTexCoord;
varying vec3 vT;
varying vec3 vB;
varying vec3 vN;

uniform vec3 uLightPos;

uniform sampler2D uDiffuseMap;
uniform sampler2D uNormalMap;
uniform sampler2D uSpecularMap;

uniform vec3 uAmbientColor;
uniform vec3 uDiffuseColor;
uniform vec3 uSpecularColor;
uniform float uShininess;

// === Texture transform uniforms ===
uniform vec2 uTexCenter;    // pivot in (u,v)
uniform float uTexScale;    // uniform scale
uniform float uTexRotation; // rotation in radians

void main() {
    // Build TBN matrix (eye space)
    vec3 T = normalize(vT);
    vec3 B = normalize(vB);
    vec3 N = normalize(vN);
    mat3 TBN = mat3(T, B, N);

    // --- Texture coordinate transform: scale + rotate around uTexCenter ---
    vec2 uv = vTexCoord;

    // shift to pivot
    uv -= uTexCenter;

    // scale
    uv *= uTexScale;

    // rotate
    float c = cos(uTexRotation);
    float s = sin(uTexRotation);
    mat2 R = mat2(c, -s,
                  s,  c);
    uv = R * uv;

    // shift back
    uv += uTexCenter;

    // 1) Normal from normal map (tangent space -> eye space)
    vec3 nTex = texture2D(uNormalMap, uv).rgb;
    nTex = nTex * 2.0 - 1.0;   // [0,1] -> [-1,1]
    vec3 Neye = normalize(TBN * nTex);

    // 2) Lighting vectors
    vec3 L = normalize(uLightPos - vPosition);
    float lambert = max(dot(Neye, L), 0.0);

    // viewer direction approximation (0,0,1)
    vec3 V = vec3(0.0, 0.0, 1.0);
    vec3 Rv = reflect(-L, Neye);
    float spec = 0.0;
    if (lambert > 0.0) {
        spec = pow(max(dot(Rv, V), 0.0), uShininess);
    }

    // 3) Sample textures with transformed uv
    vec3 texDiffuse   = texture2D(uDiffuseMap,  uv).rgb;
    float texSpecular = texture2D(uSpecularMap, uv).r;

    // 4) Final color
    vec3 color =
        uAmbientColor * texDiffuse +
        uDiffuseColor * lambert * texDiffuse +
        uSpecularColor * spec * texSpecular;

    gl_FragColor = vec4(color, 1.0);
}`;
